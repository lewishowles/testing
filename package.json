{
	"name": "@lewishowles/testing",
	"version": "1.3.0",
	"description": "Shared testing conventions and utilities for Lewis Howles projects, covering Vitest, Vue/component tests, and Playwright.",
	"repository": {
		"type": "git",
		"url": "https://github.com/lewishowles/testing.git"
	},
	"files": [
		"src/playwright",
		"src/shared",
		"src/vitest",
		"src/vue",
		"!src/**/*.test.js",
		"docs",
		"CHANGELOG.md"
	],
	"type": "module",
	"exports": {
		"./playwright": {
			"types": "./src/playwright/index.d.ts",
			"default": "./src/playwright/index.js"
		},
		"./vitest": {
			"types": "./src/vitest/index.d.ts",
			"default": "./src/vitest/index.js"
		},
		"./vue": {
			"types": "./src/vue/index.d.ts",
			"default": "./src/vue/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"check": "vp check --fix",
		"check:size": "pkg-checks size . --config quality.config.json",
		"lint": "vp check",
		"test:unit": "vp test run"
	},
	"devDependencies": {
		"@lewishowles/lint-config": "^0.6.1",
		"@lewishowles/pkg-checks": "^0.2.1",
		"@pinia/colada": "^1.3.1",
		"@playwright/test": "^1.61.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@vue/test-utils": "^2.4.11",
		"happy-dom": "^20.10.6",
		"pinia": "^3.0.4",
		"vite-plus": "0.2.8",
		"vitest": "4.1.10",
		"vue": "^3.5.39",
		"vue-router": "^5.3.1"
	},
	"peerDependencies": {
		"@pinia/colada": "^1.3.1",
		"@playwright/test": "^1.0.0",
		"@vue/test-utils": "^2.4.11",
		"pinia": "^3.0.4",
		"vitest": "*",
		"vue": "^3.5.0"
	}
}
