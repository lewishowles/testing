{
	"extends": [
		"./node_modules/@lewishowles/lint-config/base.json",
		"./node_modules/@lewishowles/lint-config/comments.json"
	],
	"env": { "builtin": true, "browser": true },
	"ignorePatterns": ["**/.*"],
	"overrides": [
		{
			"files": ["src/playwright/**/*.js"],
			"env": { "node": true }
		},
		{
			"files": ["**/*.d.ts"],
			"rules": {
				"vite-plus/prefer-vite-plus-imports": "off"
			}
		}
	]
}
